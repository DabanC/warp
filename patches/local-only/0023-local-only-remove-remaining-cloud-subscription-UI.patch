+scan_local_only_ui_forbidden() {
+  local scan_root="$1"
+  shift
+  local -a targets=("$@")
+  local -a existing_targets=()
+
+  for target in "${targets[@]}"; do
+    if [[ -e "$scan_root/$target" ]]; then
+      existing_targets+=("$scan_root/$target")
+    fi
+  done
+
+  if [[ "${#existing_targets[@]}" -eq 0 ]]; then
+    echo "No local-only UI scan targets exist under $scan_root"
+    return 0
+  fi
+
+  local rg_status
+  rg_status=0
+  rg -n --hidden --glob '!target/**' --glob '!.git/**' "$LOCAL_ONLY_UI_FORBIDDEN_REGEX" "${existing_targets[@]}" || rg_status="$?"
+
+  case "$rg_status" in
+    0)
+      return 1
+      ;;
+    1)
+      return 0
+      ;;
+    *)
+      local_only_die "ripgrep local-only UI scan failed with status $rg_status"
+      ;;
+  esac
+}
