+scan_onboarding_welcome_login_forbidden() {
+  local scan_root="$1"
+  local target="$scan_root/$ONBOARDING_WELCOME_LOGIN_TARGET"
+
+  if [[ ! -e "$target" ]]; then
+    echo "No onboarding welcome login target exists at $target"
+    return 0
+  fi
+
+  local rg_status
+  rg_status=0
+  rg -n --hidden --glob '!target/**' --glob '!.git/**' "$ONBOARDING_WELCOME_LOGIN_FORBIDDEN_REGEX" "$target" || rg_status="$?"
+
+  case "$rg_status" in
+    0)
+      return 1
+      ;;
+    1)
+      return 0
+      ;;
+    *)
+      local_only_die "ripgrep onboarding welcome login scan failed with status $rg_status"
+      ;;
+  esac
+}
