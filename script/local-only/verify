#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=script/local-only/lib.sh
source "$ROOT/script/local-only/lib.sh"

RUN_CARGO=true
RUN_STATIC=true
RUN_SELF_TEST=false

usage() {
  cat <<'USAGE'
Usage: script/local-only/verify [--self-test] [--static-only] [--skip-static] [--skip-cargo]

Runs local-only verification checks.

Options:
  --self-test     Validate the verifier against generated pass/fail fixtures.
  --static-only   Run static scans without cargo check.
  --skip-static   Run cargo check without static scans.
  --skip-cargo    Run static scans without cargo check.
USAGE
}

while (( "$#" )); do
  case "$1" in
    --self-test)
      RUN_SELF_TEST=true
      RUN_CARGO=false
      RUN_STATIC=false
      shift
      ;;
    --static-only)
      RUN_CARGO=false
      RUN_STATIC=true
      shift
      ;;
    --skip-static)
      RUN_STATIC=false
      shift
      ;;
    --skip-cargo)
      RUN_CARGO=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      local_only_die "unknown argument: $1"
      ;;
  esac
done

local_only_require_cmd git
local_only_require_cmd rg

FORBIDDEN_REGEX='(app\.warp\.dev|api\.warp\.dev|graphql/v2|stripeBillingPortal|freeAvailableModels|GetRequestLimitInfo|GetAiOveragesForWorkspace|createAnonymousUser|create_anonymous_user|Rudder|rudder|Sentry|sentry|crash_reporting|crash reporting|remote config|feature flag fetch|warp_server_client|warp_graphql|firebase|managed_secrets|BillingMetadata|CustomerType|DelinquencyStatus)'
REQUIRED_REGEX='(api key|API key|ApiKey|base_url|Base URL|base URL|custom endpoint|custom_endpoint)'
SCAN_TARGETS=("app/src" "crates" "Cargo.toml" "app/Cargo.toml")
AUTH_ACCOUNT_TARGETS=("app/src/auth" "app/src/root_view.rs" "app/src/workspace/global_actions.rs" "app/src/app_menus.rs" "app/src/lib.rs")
AUTH_ACCOUNT_FORBIDDEN_REGEX='(createAnonymousUser|create_anonymous_user|debug_create_anonymous_user|workspace:debug_create_anonymous_user|Authenticating via API key|WARP_USER_SECRET|PersistedUser::from_secure_storage|/signup/remote|/login/remote|/upgrade\?|/login_options/|/link_sso|UserInitiatedLogOut|LogOutModalShown|LoggedOutStartup|determine_and_report)'
ONBOARDING_WELCOME_LOGIN_TARGET="crates/onboarding/src/slides/intro_slide.rs"
ONBOARDING_WELCOME_LOGIN_FORBIDDEN_REGEX='(Already have an account\?|"Log in"|IntroSlideEvent|LoginClicked|LoginRequested|WelcomeLoginClicked)'
LOCAL_ONLY_UI_TARGETS=("app/src/settings_view/mod.rs" "app/src/settings_view/ai_page.rs" "app/src/drive/settings.rs" "app/src/drive/index.rs")
LOCAL_ONLY_UI_FORBIDDEN_REGEX='(SettingsNavItem::Page\(SettingsSection::Account\)|SettingsNavItem::Page\(SettingsSection::BillingAndUsage\)|SettingsNavItem::Page\(SettingsSection::Teams\)|SettingsNavItem::Page\(SettingsSection::Warpify\)|SettingsNavItem::Page\(SettingsSection::Referrals\)|SettingsNavItem::Page\(SettingsSection::SharedBlocks\)|SettingsNavItem::Page\(SettingsSection::WarpDrive\)|"Cloud platform"|CloudHandoffWidget::default\(\)|FeatureFlag::CustomInferenceEndpoints\.is_enabled\(\)|sections\.insert\([^)]*DriveIndexSection::(CreateATeam|JoinTeam)|Collaborate with .* teammates already on Warp|Upgrade to the Build plan|Ask your team'"'"'s admin to upgrade to the Build plan|to use your own API keys\.|Create an account"|Warp credit fallback|Cloud handoff|Cloud Handoff|Auto-handoff before sleep|Use & to trigger handoff|Share commands & knowledge with your teammates\.|Create team)'

scan_forbidden() {
  local scan_root="$1"
  shift
  local -a targets=("$@")
  local -a existing_targets=()

  for target in "${targets[@]}"; do
    if [[ -e "$scan_root/$target" ]]; then
      existing_targets+=("$scan_root/$target")
    fi
  done

  if [[ "${#existing_targets[@]}" -eq 0 ]]; then
    echo "No scan targets exist under $scan_root"
    return 0
  fi

  local rg_status
  rg_status=0
  rg -n --hidden --glob '!target/**' --glob '!.git/**' --glob '!docs/superpowers/**' --glob '!patches/local-only/**' "$FORBIDDEN_REGEX" "${existing_targets[@]}" || rg_status="$?"

  case "$rg_status" in
    0)
      return 1
      ;;
    1)
      return 0
      ;;
    *)
      local_only_die "ripgrep forbidden scan failed with status $rg_status"
      ;;
  esac
}

scan_required_ai_config() {
  local scan_root="$1"
  if rg -n --hidden --glob '!target/**' --glob '!.git/**' "$REQUIRED_REGEX" "$scan_root/app/src" "$scan_root/crates/ai" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

scan_auth_account_forbidden() {
  local scan_root="$1"
  shift
  local -a targets=("$@")
  local -a existing_targets=()

  for target in "${targets[@]}"; do
    if [[ -e "$scan_root/$target" ]]; then
      existing_targets+=("$scan_root/$target")
    fi
  done

  if [[ "${#existing_targets[@]}" -eq 0 ]]; then
    echo "No auth/account scan targets exist under $scan_root"
    return 0
  fi

  local rg_status
  rg_status=0
  rg -n --hidden --glob '!target/**' --glob '!.git/**' "$AUTH_ACCOUNT_FORBIDDEN_REGEX" "${existing_targets[@]}" || rg_status="$?"

  case "$rg_status" in
    0)
      return 1
      ;;
    1)
      return 0
      ;;
    *)
      local_only_die "ripgrep auth/account scan failed with status $rg_status"
      ;;
  esac
}

scan_onboarding_welcome_login_forbidden() {
  local scan_root="$1"
  local target="$scan_root/$ONBOARDING_WELCOME_LOGIN_TARGET"

  if [[ ! -e "$target" ]]; then
    echo "No onboarding welcome login target exists at $target"
    return 0
  fi

  local rg_status
  rg_status=0
  rg -n --hidden --glob '!target/**' --glob '!.git/**' "$ONBOARDING_WELCOME_LOGIN_FORBIDDEN_REGEX" "$target" || rg_status="$?"

  case "$rg_status" in
    0)
      return 1
      ;;
    1)
      return 0
      ;;
    *)
      local_only_die "ripgrep onboarding welcome login scan failed with status $rg_status"
      ;;
  esac
}

scan_local_only_ui_forbidden() {
  local scan_root="$1"
  shift
  local -a targets=("$@")
  local -a existing_targets=()

  for target in "${targets[@]}"; do
    if [[ -e "$scan_root/$target" ]]; then
      existing_targets+=("$scan_root/$target")
    fi
  done

  if [[ "${#existing_targets[@]}" -eq 0 ]]; then
    echo "No local-only UI scan targets exist under $scan_root"
    return 0
  fi

  local rg_status
  rg_status=0
  rg -n --hidden --glob '!target/**' --glob '!.git/**' "$LOCAL_ONLY_UI_FORBIDDEN_REGEX" "${existing_targets[@]}" || rg_status="$?"

  case "$rg_status" in
    0)
      return 1
      ;;
    1)
      return 0
      ;;
    *)
      local_only_die "ripgrep local-only UI scan failed with status $rg_status"
      ;;
  esac
}

run_self_test() {
  local_only_print_header "Running verifier self-test"
  local tmp
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  mkdir -p "$tmp/app/src" "$tmp/crates/ai" "$tmp/app/src/settings_view" "$tmp/app/src/drive"

  cat > "$tmp/app/src/local.rs" <<'PASS_FIXTURE'
pub fn local_terminal_marker() -> &'static str {
    "local terminal"
}
PASS_FIXTURE

  cat > "$tmp/crates/ai/config.rs" <<'AI_FIXTURE'
pub struct LocalAiConfig {
    pub api_key: String,
    pub base_url: String,
}
AI_FIXTURE

  if ! scan_forbidden "$tmp" "app/src" "crates"; then
    local_only_die "self-test pass fixture was reported as forbidden"
  fi

  cat > "$tmp/app/src/cloud.rs" <<'FAIL_FIXTURE'
pub const WARP_GRAPHQL: &str = "https://app.warp.dev/graphql/v2";
FAIL_FIXTURE

  if scan_forbidden "$tmp" "app/src" "crates"; then
    local_only_die "self-test fail fixture was not reported as forbidden"
  fi

  if ! scan_auth_account_forbidden "$tmp" "app/src"; then
    local_only_die "self-test auth/account scan reported clean fixture as forbidden"
  fi

  cat > "$tmp/app/src/auth_prompt.rs" <<'AUTH_FAIL_FIXTURE'
pub const SIGNUP_URL: &str = "/signup/remote";
AUTH_FAIL_FIXTURE

  if scan_auth_account_forbidden "$tmp" "app/src"; then
    local_only_die "self-test auth/account fail fixture was not reported as forbidden"
  fi

  mkdir -p "$tmp/crates/onboarding/src/slides"
  cat > "$tmp/crates/onboarding/src/slides/intro_slide.rs" <<'ONBOARDING_PASS_FIXTURE'
pub const WELCOME_TEXT: &str = "Welcome to Warp";
ONBOARDING_PASS_FIXTURE

  if ! scan_onboarding_welcome_login_forbidden "$tmp"; then
    local_only_die "self-test onboarding welcome login scan reported clean fixture as forbidden"
  fi

  cat > "$tmp/crates/onboarding/src/slides/intro_slide.rs" <<'ONBOARDING_FAIL_FIXTURE'
pub const LOGIN_PROMPT: &str = "Already have an account? Log in";
ONBOARDING_FAIL_FIXTURE

  if scan_onboarding_welcome_login_forbidden "$tmp"; then
    local_only_die "self-test onboarding welcome login fail fixture was not reported as forbidden"
  fi

  cat > "$tmp/app/src/settings_view/mod.rs" <<'LOCAL_UI_PASS_FIXTURE'
let nav_items = vec![SettingsNavItem::Page(SettingsSection::Appearance)];
LOCAL_UI_PASS_FIXTURE
  cat > "$tmp/app/src/settings_view/ai_page.rs" <<'LOCAL_AI_PASS_FIXTURE'
pub const API_KEYS: &str = "API Keys";
LOCAL_AI_PASS_FIXTURE
  cat > "$tmp/app/src/drive/settings.rs" <<'LOCAL_DRIVE_PASS_FIXTURE'
pub fn is_warp_drive_enabled() -> bool { false }
LOCAL_DRIVE_PASS_FIXTURE

  if ! scan_local_only_ui_forbidden "$tmp" "${LOCAL_ONLY_UI_TARGETS[@]}"; then
    local_only_die "self-test local-only UI scan reported clean fixture as forbidden"
  fi

  cat > "$tmp/app/src/settings_view/ai_page.rs" <<'LOCAL_AI_FAIL_FIXTURE'
pub const UPGRADE: &str = "Upgrade to the Build plan to use your own API keys.";
pub const HANDOFF: &str = "Cloud handoff";
pub fn show_custom_inference() -> bool { FeatureFlag::CustomInferenceEndpoints.is_enabled() }
LOCAL_AI_FAIL_FIXTURE
  cat > "$tmp/app/src/drive/index.rs" <<'LOCAL_DRIVE_FAIL_FIXTURE'
sections.insert(0, DriveIndexSection::CreateATeam);
pub const JOIN: &str = "Collaborate with 1 of your teammates already on Warp.";
LOCAL_DRIVE_FAIL_FIXTURE

  if scan_local_only_ui_forbidden "$tmp" "${LOCAL_ONLY_UI_TARGETS[@]}"; then
    local_only_die "self-test local-only UI fail fixture was not reported as forbidden"
  fi

  if ! scan_required_ai_config "$tmp"; then
    local_only_die "self-test AI config fixture was not detected"
  fi

  rm -rf "$tmp"
  echo "Verifier self-test passed."
}

if [[ "$RUN_SELF_TEST" == true ]]; then
  run_self_test
  exit 0
fi

if [[ "$RUN_CARGO" == true ]]; then
  local_only_print_header "Running cargo check for app"
  cargo check -p warp --bin warp-oss
fi

if [[ "$RUN_STATIC" == true ]]; then
  local_only_print_header "Scanning local-only auth/account entry points"
  if ! scan_auth_account_forbidden "$ROOT" "${AUTH_ACCOUNT_TARGETS[@]}"; then
    local_only_die "forbidden auth/account entry points remain"
  fi

  local_only_print_header "Scanning onboarding welcome login prompt"
  if ! scan_onboarding_welcome_login_forbidden "$ROOT"; then
    local_only_die "onboarding welcome login prompt remains"
  fi

  local_only_print_header "Scanning local-only UI gates"
  if ! scan_local_only_ui_forbidden "$ROOT" "${LOCAL_ONLY_UI_TARGETS[@]}"; then
    local_only_die "forbidden account/cloud/subscription UI remains"
  fi

  local_only_print_header "Scanning for forbidden cloud/account surfaces"
  if ! scan_forbidden "$ROOT" "${SCAN_TARGETS[@]}"; then
    local_only_die "forbidden cloud/account surfaces remain"
  fi

  local_only_print_header "Checking AI configuration surface"
  if ! scan_required_ai_config "$ROOT"; then
    local_only_die "could not find AI API key/Base URL configuration surface"
  fi
fi

echo "Local-only verification passed."
